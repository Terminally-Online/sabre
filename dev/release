#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
REGISTRY="ghcr.io/terminally-online/sabre"
TARGETS="linux/amd64 linux/arm64 windows/amd64 darwin/amd64 darwin/arm64"

branch="$(git branch --show-current)"
[[ "$branch" == "master" ]] || {
	echo "FAIL: release runs from master (on ${branch})"
	exit 1
}
[[ -z "$(git status --porcelain)" ]] || {
	echo "FAIL: repository has uncommitted changes"
	exit 1
}
git fetch -q origin master
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/master)" ]] || {
	echo "FAIL: HEAD is not origin/master — push or pull first"
	exit 1
}

if [[ -n "${1:-}" ]]; then
	v="${1#v}"
else
	latest="$(git tag --list 'v*' --sort=-v:refname | head -1)"
	if [[ -z "$latest" ]]; then
		v="0.1.0"
	else
		subjects="$(git log "$latest"..HEAD --pretty=%s)"
		if [[ -z "$subjects" ]]; then
			echo "nothing new since ${latest}"
			exit 0
		fi
		major="$(echo "${latest#v}" | cut -d. -f1)"
		minor="$(echo "${latest#v}" | cut -d. -f2)"
		patch="$(echo "${latest#v}" | cut -d. -f3)"
		if git log "$latest"..HEAD --pretty='%s%n%b' | grep -qE '^BREAKING CHANGE|^[a-z]+(\([^)]*\))?!:'; then
			major=$((major + 1)) minor=0 patch=0
		elif echo "$subjects" | grep -qE '^feat(\([^)]*\))?:'; then
			minor=$((minor + 1)) patch=0
		else
			patch=$((patch + 1))
		fi
		v="${major}.${minor}.${patch}"
	fi
fi
series="$(echo "$v" | cut -d. -f1-2)"
echo "releasing v${v} (series ${series})"

dev/verify

rm -rf dist && mkdir -p dist
ldflags="-X main.Version=v${v} -X main.BuildTime=$(date -u '+%Y-%m-%d_%H:%M:%S')"
for target in $TARGETS; do
	goos="${target%/*}" goarch="${target#*/}" ext=""
	[[ "$goos" == "windows" ]] && ext=".exe"
	echo "building ${goos}/${goarch}"
	GOOS="$goos" GOARCH="$goarch" CGO_ENABLED=0 \
		go build -ldflags "$ldflags" -o "dist/sabre-${goos}-${goarch}${ext}" ./cmd/sabre
done
(cd dist && shasum -a 256 sabre-* >checksums.txt)

gh auth token | docker login ghcr.io -u "$(gh api user --jq .login)" --password-stdin >/dev/null || {
	echo "FAIL: ghcr login — the gh token needs write:packages:"
	echo "  gh auth refresh -h github.com -s write:packages"
	exit 1
}
docker buildx inspect release-builder >/dev/null 2>&1 ||
	docker buildx create --name release-builder --driver docker-container >/dev/null
docker buildx build --builder release-builder \
	--platform linux/amd64,linux/arm64 --push \
	-t "${REGISTRY}:${v}" -t "${REGISTRY}:${series}" -t "${REGISTRY}:latest" \
	--build-arg "VERSION=${v}" .

git tag "v${v}"
git push -q origin "v${v}"
gh release create "v${v}" dist/* --title "Release v${v}" --generate-notes

echo "released v${v}"
