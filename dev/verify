#!/usr/bin/env bash
set -euo pipefail

crew_bin() {
	if command -v crew >/dev/null 2>&1; then
		command -v crew
		return 0
	fi
	local candidate
	for candidate in \
		"$(git rev-parse --show-toplevel)/../crew/crew" \
		"$HOME/github/terminally-online/crew/crew"; do
		[[ -x "$candidate" ]] && echo "$candidate" && return 0
	done
	return 1
}

CREW="$(crew_bin)" || {
	echo "FAIL: crew not found."
	echo "Build it: cd ~/github/terminally-online/crew && go build -o crew ."
	exit 1
}

exec "$CREW" verify -C "$(git rev-parse --show-toplevel)" "$@"
