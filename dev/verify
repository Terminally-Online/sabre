#!/usr/bin/env bash
set -uo pipefail

GOLANGCI_LINT_VERSION="v2.11.3"
JOBS=(lint test build security)

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
TOOLS="$ROOT/.data/verify/bin"
mkdir -p "$TOOLS"
export GOLANGCI_LINT_CACHE="$ROOT/.data/verify/cache"
export CGO_ENABLED=0

OUT="$(mktemp -d)"
trap 'rm -rf "$OUT"' EXIT

signoff=false
[[ "${1:-}" == "--signoff" ]] && signoff=true

ensure_golangci_lint() {
	"$TOOLS/golangci-lint" version 2>/dev/null | grep -q "${GOLANGCI_LINT_VERSION#v}" && return 0
	curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh |
		sh -s -- -b "$TOOLS" "$GOLANGCI_LINT_VERSION" >/dev/null 2>&1
}

lint_base() {
	git fetch -q origin master 2>/dev/null || true
	local base head
	head="$(git rev-parse HEAD)"
	base="$(git merge-base origin/master HEAD 2>/dev/null || true)"
	if [[ -z "$base" || "$base" == "$head" ]]; then
		git rev-parse HEAD~1
	else
		echo "$base"
	fi
}

job_lint() {
	ensure_golangci_lint || return 1
	go vet ./... || return 1
	"$TOOLS/golangci-lint" run --allow-parallel-runners --timeout=5m --new-from-rev="$(lint_base)"
}

job_test() {
	go test -v -race ./...
}

job_build() {
	local goos
	for goos in linux windows darwin; do
		GOOS="$goos" GOARCH=amd64 go build -o /dev/null ./cmd/sabre || return 1
	done
}

job_security() {
	GOBIN="$TOOLS" go install golang.org/x/vuln/cmd/govulncheck@latest || return 1
	"$TOOLS/govulncheck" ./... || return 1
	GOBIN="$TOOLS" go install honnef.co/go/tools/cmd/staticcheck@latest || return 1
	"$TOOLS/staticcheck" ./... || return 1
	docker run --rm -v "$ROOT:/pwd" trufflesecurity/trufflehog:latest \
		filesystem --directory /pwd --only-verified --fail
}

run_job() {
	local name="$1" start="$SECONDS"
	if "job_$name" >"$OUT/$name.log" 2>&1; then
		echo ok >"$OUT/$name.status"
	else
		echo fail >"$OUT/$name.status"
	fi
	echo $((SECONDS - start)) >"$OUT/$name.time"
}

for j in "${JOBS[@]}"; do
	run_job "$j" &
done
wait

failed=()
for j in "${JOBS[@]}"; do
	printf '%-10s %-6s %ss\n' "$j" "$(cat "$OUT/$j.status")" "$(cat "$OUT/$j.time")"
	[[ "$(cat "$OUT/$j.status")" == ok ]] || failed+=("$j")
done

if ((${#failed[@]})); then
	for j in "${failed[@]}"; do
		printf '\n────── %s ──────\n' "$j"
		cat "$OUT/$j.log"
	done
	exit 1
fi

if $signoff; then
	gh signoff "${JOBS[@]}" || exit 1
fi

echo verified
