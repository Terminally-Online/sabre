#!/usr/bin/env bash
set -uo pipefail
source "$(dirname "$0")/common"

"$TOOLS/staticcheck" ./... || exit 1

docker_ready() {
	command -v docker >/dev/null 2>&1 || return 1
	docker info >/dev/null 2>&1 &
	local pid=$! i
	for i in $(seq 1 10); do
		if ! kill -0 "$pid" 2>/dev/null; then
			wait "$pid"
			return $?
		fi
		sleep 1
	done
	kill -9 "$pid" 2>/dev/null
	return 1
}

if ! docker_ready; then
	echo "FAIL: the vulnerability gate and the secret scan need docker, and it is not responding."
	echo "Start Docker Desktop, then rerun this lane."
	exit 1
fi

common="$(git rev-parse --path-format=absolute --git-common-dir)"
docker run --rm --platform linux/amd64 \
	-v "$ROOT:$ROOT:ro" -v "$common:$common:ro" -w "$ROOT" \
	-v vulngate-gomod:/go/pkg/mod -v vulngate-gocache:/root/.cache/go-build \
	git.ca.plug.to/terminally-online/ci-security:1 vulngate || exit 1

docker run --rm -v "$ROOT:/pwd" trufflesecurity/trufflehog:latest \
	filesystem --directory /pwd --only-verified --fail
